# Force LF line endings for all text files
* text=auto eol=lf

# Rust
*.rs text eol=lf
*.toml text eol=lf

# Flutter/Dart
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Android
*.gradle text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# C/C++
*.cpp text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.c text eol=lf

# CMake
CMakeLists.txt text eol=lf
*.cmake text eol=lf

# Shell
*.sh text eol=lf

# Web
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binaries — no conversion
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.keystore binary
